{
  "name": "chatten-cafe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.mjs",
    "admin:bootstrap": "node --use-system-ca scripts/admin-bootstrap.mjs",
    "e2e:auth:provision": "node --use-system-ca --env-file-if-exists=.env.local scripts/e2e-auth-provision.mjs",
    "e2e:auth:session": "node --use-system-ca --env-file-if-exists=.env.local scripts/e2e-auth-session.mjs",
    "e2e:auth:cleanup": "node --use-system-ca --env-file-if-exists=.env.local scripts/e2e-auth-cleanup.mjs",
    "media:import": "node --use-system-ca --env-file-if-exists=.env.local scripts/media-import.mjs",
    "types:generate": "node scripts/gen-types.mjs",
    "types:check": "node scripts/gen-types.mjs --check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "^16.3.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
