# Template konfigurasi Chatten Cafe. Salin menjadi .env.local lalu isi nilainya:
#   cp .env.example .env.local
#
# File ini SATU-SATUNYA varian .env yang di-commit; .gitignore menutup sisanya.
# Jangan pernah menaruh nilai asli di sini.
#
# PENTING soal NEXT_PUBLIC_*: nilainya dipanggang ke dalam bundle browser saat
# BUILD, bukan dibaca saat runtime. Menambah variabel NEXT_PUBLIC_* baru tidak
# cukup hanya di .env.local — wajib didaftarkan juga sebagai ARG di Dockerfile
# dan build.args di docker-compose.yml, kalau tidak nilainya terpanggang
# sebagai `undefined` dan fiturnya mati tanpa pesan error.
#
# Rebuild container:  docker compose --env-file .env.local up -d --build
# Flag --env-file wajib; tanpa itu build.args kosong.

# ---------------------------------------------------------------------------
# Supabase (self-hosted) — wajib
# ---------------------------------------------------------------------------
# Origin PostgREST/GoTrue. Skema database yang dipakai: chatten_cafe.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.com

# Kunci anon. Memang untuk browser — RLS yang menegakkan izin, bukan
# kerahasiaan kunci ini.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-self-hosted-anon-key

# HANYA SERVER. Melewati seluruh RLS. Jangan pernah diberi awalan
# NEXT_PUBLIC_, jangan pernah dijadikan ARG di Dockerfile, jangan pernah
# diimpor dari komponen "use client".
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# ---------------------------------------------------------------------------
# Aplikasi — wajib
# ---------------------------------------------------------------------------
# Satu-satunya sumber origin absolut situs: canonical URL, Open Graph,
# sitemap.xml, JSON-LD. next.config.ts memanggil assertAppUrl(): build produksi
# tanpa nilai ini GAGAL, nilai localhost hanya memberi peringatan.
# Harus cocok dengan APP_PORT. Ganti ke https://<domain> saat deploy, lalu
# REBUILD — mengubahnya tanpa rebuild tidak berpengaruh.
NEXT_PUBLIC_APP_URL=http://localhost:3010

# Port host untuk container.
APP_PORT=3010

# ---------------------------------------------------------------------------
# Chatwoot (widget live-chat) — opsional
# ---------------------------------------------------------------------------
# Isi KEDUANYA untuk mengaktifkan, kosongkan KEDUANYA untuk menonaktifkan.
# Mengisi salah satu saja membuat build gagal (lib/env/chatwoot.ts), disengaja.
# Website token memang publik: terlihat di source setiap situs yang memasang
# widget, dan hanya menentukan inbox mana yang menerima pesan. Base URL harus
# origin telanjang; path akan dibuang. Mengisi keduanya juga melebarkan CSP
# (script-src, frame-src, connect-src + wss) ke origin Chatwoot.
NEXT_PUBLIC_CHATWOOT_BASE_URL=https://chatwoot.example.com
NEXT_PUBLIC_CHATWOOT_TOKEN=replace-with-chatwoot-website-token

# ---------------------------------------------------------------------------
# Perkakas pengembang — opsional, tidak dipakai aplikasi saat runtime
# ---------------------------------------------------------------------------
# scripts/gen-types.mjs (npm run gen:types) menjalankan pg_dump lewat SSH.
# Kosongkan untuk memakai default yang tertulis di skripnya.
# SUPABASE_SSH_HOST=user@host
# SUPABASE_DOCKER_DIR=~/docker/supabase/<versi>/docker

# Pengaman scripts/e2e-auth-*.mjs: skrip itu MEMBUAT dan MENGHAPUS user Auth
# sungguhan di server. Biarkan mati; set true hanya untuk satu kali pemakaian.
# E2E_ALLOW_REMOTE_SUPABASE=true
